{
  "name": "meta-beacon",
  "version": "1.0.0",
  "description": "Audit titles, meta descriptions, Open Graph and Twitter/X card tags across a built static site: presence, duplicates in the head, length, absolute URLs and real og:image files (dimensions, format, size). Text/JSON/SARIF/Markdown, allowlist with expiry, GitHub Action. Zero deps.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "meta-beacon": "bin/meta-beacon.js"
  },
  "files": [
    "src",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "meta-tags",
    "open-graph",
    "twitter-card",
    "og-image",
    "title",
    "meta-description",
    "seo",
    "static-site",
    "html",
    "sarif",
    "github-action"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/meta-beacon.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/meta-beacon/issues"
  },
  "homepage": "https://github.com/MrLouisWright/meta-beacon#readme"
}
